# Copy to .env for local runs, or set these in your host's dashboard.
# Every value is optional; the product works without any of them.

# Optional assistant and model-assisted extraction. Without a key both the
# assistant and every claim path stay deterministic; no model call is made.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Set to false to keep extraction deterministic even when a key is present.
# LLM_EXTRACTION=true

# Optional GitHub OAuth app. Register an OAuth app at
# https://github.com/settings/developers with the callback URL
# <origin>/api/github/oauth/callback. Without these, public repositories and a
# pasted read-only token still work.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPE=repo read:user
# GITHUB_OAUTH_REDIRECT=https://your-host/api/github/oauth/callback

# Password for the five install accounts (admin, reviewer, departing, incoming, viewer).
# INSTALL_PASSWORD=contextbridge

# Set to false on a public deployment so the sign-in page stops listing the
# demo accounts and their shared password.
# EXPOSE_INSTALL_ACCOUNTS=false

# Where the SQLite file lives. Point this at a persistent disk in production.
# CONTEXTBRIDGE_DB=/var/data/contextbridge.db

# Server port (defaults to 3000; most hosts inject PORT themselves).
# PORT=3000
